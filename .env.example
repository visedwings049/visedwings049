# Copy this file to .env and fill in real values. Never commit .env itself.

# Gmail SMTP app password (generate at https://myaccount.google.com/apppasswords)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# TeacherEase login used by the scraper
TEACHEREASE_USERNAME=
TEACHEREASE_PASSWORD=

# Where daily report emails get sent
REPORT_TO_EMAIL=
